<Window x:Class="MemoAI.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="using:MemoAI.Core" xmlns:ui="using:MemoAI.App" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" Title="WinWhisper">
 <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" PreviewKeyDown="Workspace_KeyDown">
  <Grid.Resources><DataTemplate x:Key="TranscriptPreviewTemplate" x:DataType="core:SubtitleSegment"><StackPanel Padding="4,8" Spacing="4"><TextBlock Text="{x:Bind TimeLabel}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="14"/><TextBlock Text="{x:Bind Translation}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate><DataTemplate x:Key="TranscriptDiffTemplate" x:DataType="core:TranscriptDiff"><StackPanel Padding="4,9" Spacing="5"><TextBlock Text="{x:Bind TimeLabel}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{x:Bind Kind}" FontSize="12"/><ui:TranscriptDiffView Diff="{x:Bind}"/></StackPanel></DataTemplate></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border x:Name="StableBackground" Grid.RowSpan="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" IsHitTestVisible="False"/>
  <Grid x:Name="TitleBar" Margin="6,0,150,0" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="NavigationBack" Style="{StaticResource SubtleButtonStyle}" Width="34" Height="34" Padding="8" BorderThickness="0" VerticalAlignment="Center" Click="Back_Click" ToolTipService.ToolTip="返回 · Alt+←" AutomationProperties.Name="返回"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button>
   <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent">
    <TextBlock Text="WinWhisper" FontSize="13" VerticalAlignment="Center"/>
   </Grid>
  </Grid>
  <NavigationView x:Name="Sidebar" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="222" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged" IsTabStop="False">
   <NavigationView.PaneHeader>
    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="12,12,12,14" Click="Import_Click" Padding="14,11"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" FontSize="15"/><TextBlock Text="导入音视频"/></StackPanel></Button>
   </NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="NavLibrary" Content="媒体库" Tag="library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="NavQueue" Content="任务与历史" Tag="queue"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="NavRecord" Content="录音" Tag="record"><NavigationViewItem.Icon><FontIcon Glyph="&#xE720;"/></NavigationViewItem.Icon><NavigationViewItem.InfoBadge><InfoBadge x:Name="RecordingBadge" Visibility="Collapsed"/></NavigationViewItem.InfoBadge></NavigationViewItem>
    <NavigationViewItem x:Name="NavLink" Content="导入在线链接" Tag="link"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemHeader Content="最近打开" Margin="0,14,0,0"/>
    <NavigationViewItem x:Name="RecentHost" SelectsOnInvoked="False" IsTabStop="False" Padding="0" HorizontalContentAlignment="Stretch">
     <NavigationViewItem.Template><ControlTemplate TargetType="NavigationViewItem"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/></ControlTemplate></NavigationViewItem.Template>
     <ListView x:Name="RecentList" MaxHeight="350" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Library_ItemClick" Background="Transparent" BorderThickness="0">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource SingleSurfaceListItem}"><Setter Property="Padding" Value="10"/><Setter Property="MinHeight" Value="70"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate x:DataType="core:MediaSession"><Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Title}"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B2;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind Title}" FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind DurationLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem x:Name="NavModels" Content="模型商店" Tag="models"><NavigationViewItem.Icon><FontIcon Glyph="&#xE719;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="NavSettings" Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <Grid x:Name="ShellSurface">
    <Grid x:Name="ShellLayout">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ui:ContinuousSurface x:Name="OperationNotice" Visibility="Collapsed" Grid.Row="0" Margin="24,16,24,0" Padding="14,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.AccessibilityView="Raw"/>
       <TextBlock x:Name="OperationMessage" Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="DismissOperationNotice" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="6" VerticalAlignment="Top" Click="DismissOperationNotice_Click" ToolTipService.ToolTip="关闭提示" AutomationProperties.Name="关闭提示"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
       <ProgressBar x:Name="OperationProgress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="3" Margin="0,8,0,0" Visibility="Collapsed"/>
      </Grid>
     </ui:ContinuousSurface>
     <Grid x:Name="PageHost" Grid.Row="1">
     <Grid x:Name="LibraryView" Padding="30" RowSpacing="22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><StackPanel Spacing="7"><TextBlock Text="媒体库" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="从声音到文字，再到值得留下的想法。" Style="{StaticResource Muted}"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="PasteLink_Click" Content="粘贴链接"/></Grid>
      <ui:ContinuousSurface Grid.Row="1" Style="{StaticResource Card}" Padding="24"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ui:ContinuousSurface Width="62" Height="62" CornerRadius="18" Background="{ThemeResource AccentFillColorTertiaryBrush}"><FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></ui:ContinuousSurface>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7"><TextBlock Text="把内容带进来" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="拖入音视频、SRT 或 VTT 字幕，开始本地转写与整理。" Style="{StaticResource Muted}"/></StackPanel>
       <Button Grid.Column="2" Content="选择文件" VerticalAlignment="Center" Click="Import_Click" Padding="18,9"/>
      </Grid></ui:ContinuousSurface>
      <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LibrarySearch" PlaceholderText="搜索标题、字幕与笔记" TextChanged="LibrarySearch_Changed"/><ComboBox x:Name="FolderFilter" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="全部文件夹" SelectionChanged="FolderFilter_Changed"/><Button Grid.Column="2" Content="批量转写" Click="Batch_Click"/><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"><ToggleButton x:Name="LibraryListMode" Tag="List" IsChecked="True" Click="LibraryMode_Click" ToolTipService.ToolTip="列表视图" AutomationProperties.Name="列表视图"><FontIcon Glyph="&#xE8FD;" FontSize="16"/></ToggleButton><ToggleButton x:Name="LibraryGridMode" Tag="Grid" Click="LibraryMode_Click" ToolTipService.ToolTip="缩略图视图" AutomationProperties.Name="缩略图视图"><FontIcon Glyph="&#xE8A9;" FontSize="16"/></ToggleButton></StackPanel></Grid>
      <Grid Grid.Row="3">
       <ListView x:Name="LibraryList" SelectionMode="Extended" IsItemClickEnabled="True" ItemClick="Library_ItemClick" Background="Transparent">
        <ListView.ItemTemplate><DataTemplate x:DataType="core:MediaSession"><Grid Padding="12,15" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ui:MediaThumbnail Session="{x:Bind}" Width="96" Height="54" Loaded="Thumbnail_Loaded"/>
         <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{x:Bind DurationLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <GridView x:Name="LibraryGrid" Visibility="Collapsed" SelectionMode="Extended" IsItemClickEnabled="True" ItemClick="Library_ItemClick" Background="Transparent" SizeChanged="LibraryGrid_SizeChanged">
        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="272" ItemHeight="260"/></ItemsPanelTemplate></GridView.ItemsPanel>
        <GridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource SingleSurfaceGridItem}"/></GridView.ItemContainerStyle>
        <GridView.ItemTemplate><DataTemplate x:DataType="core:MediaSession"><Grid RowSpacing="10" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><ui:MediaThumbnail x:Name="GridCover" Session="{x:Bind}" Loaded="Thumbnail_Loaded" SizeChanged="GridThumbnail_SizeChanged"/><ui:ContinuousSurface HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#B0000000" CornerRadius="4" Padding="5,2"><TextBlock Text="{x:Bind DurationLabel}" FontSize="12" Foreground="White"/></ui:ContinuousSurface></Grid><TextBlock x:Name="GridMediaTitle" Grid.Row="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="15" LineHeight="22" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}"/><TextBlock x:Name="GridMediaMeta" Grid.Row="2" Text="{x:Bind Description}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></GridView.ItemTemplate>
       </GridView>
       <StackPanel x:Name="LibraryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"><FontIcon Glyph="&#xE8F1;" FontSize="38" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><TextBlock Text="这里将收纳你的每一次灵感" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="导入第一段音视频，或从现有字幕开始。" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
     </Grid>
     <Grid x:Name="WorkspaceView" Visibility="Collapsed" RowSpacing="12" Padding="22,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="5"><TextBlock x:Name="SessionTitle" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SessionMeta" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="StartTranscribeButton" Content="开始转写" Style="{StaticResource AccentButtonStyle}" Click="Transcribe_Click"/>
        <ToggleButton x:Name="TranscriptionSettingsButton" Content="转写设置" Click="ToggleTranscriptionSettings_Click"><primitives:FlyoutBase.AttachedFlyout><Flyout x:Name="TranscriptionFlyout" Placement="BottomEdgeAlignedRight" Opening="TranscriptionFlyout_Opening" Opened="TranscriptionFlyout_Opened" Closed="TranscriptionFlyout_Closed"><Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"><Setter Property="MaxWidth" Value="680"/></Style></Flyout.FlyoutPresenterStyle><Grid x:Name="TranscriptionSettingsPanel" Width="600">      <StackPanel Spacing="16"><Grid><TextBlock Text="转写设置" FontSize="20" FontWeight="SemiBold"/><Button x:Name="CloseTranscriptionSettings" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="6" Click="CloseTranscriptionSettings_Click" AutomationProperties.Name="关闭转写设置" ToolTipService.ToolTip="关闭 · Esc"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button></Grid><TextBlock x:Name="TranscriptionSettingsSummary" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <ScrollViewer MaxHeight="450"><StackPanel Spacing="14">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="TranscriptionModel" Header="转写模型" HorizontalAlignment="Stretch" SelectionChanged="TranscriptionOption_Changed" DisplayMemberPath="Name"/>
         <ComboBox x:Name="TranscriptionLanguage" Grid.Column="1" Header="音频语言" HorizontalAlignment="Stretch" SelectionChanged="TranscriptionOption_Changed" DisplayMemberPath="Name"/>
         <ComboBox x:Name="TranscriptionBackend" Grid.Column="2" Header="硬件加速" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="TranscriptionOption_Changed"><ComboBoxItem Content="自动选择"/><ComboBoxItem Content="CUDA"/><ComboBoxItem Content="Vulkan"/><ComboBoxItem Content="CPU"/><ComboBoxItem Content="DirectML"/></ComboBox>
         <Button Grid.Column="3" Content="模型商店" VerticalAlignment="Bottom" Click="ModelStore_Click"/>
        </Grid>
        <Expander Header="高级参数" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <StackPanel Spacing="14">
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <NumberBox x:Name="TranscriptionThreads" Header="CPU 线程（0 自动）" Minimum="0" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
           <NumberBox x:Name="TranscriptionBeam" Grid.Column="1" Header="搜索宽度（1–10）" Minimum="1" Maximum="10" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
           <NumberBox x:Name="TranscriptionTemperature" Grid.Column="2" Header="采样温度（0–1）" Minimum="0" Maximum="1" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
          </Grid>
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <NumberBox x:Name="TranscriptionChunk" Header="处理分块（秒，30–900）" Minimum="30" Maximum="900" SmallChange="30" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
           <NumberBox x:Name="TranscriptionMaxLength" Grid.Column="1" Header="字幕长度（字符，0 不限）" Minimum="0" Maximum="200" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
           <CheckBox x:Name="TranscriptionVad" Grid.Column="2" Content="检测静音（VAD）" VerticalAlignment="Bottom" Checked="TranscriptionCheck_Changed" Unchecked="TranscriptionCheck_Changed"/>
          </Grid>
          <TextBox x:Name="TranscriptionPrompt" Header="专有名词与上下文提示" PlaceholderText="例如：人名、产品名、技术术语…" TextChanged="TranscriptionPrompt_Changed"/>
          <CheckBox x:Name="TranscriptionFillers" Content="自动清理英语 uh / um（保留原音频）" Checked="TranscriptionCheck_Changed" Unchecked="TranscriptionCheck_Changed"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="选择本地模型" Click="ChooseTranscriptionModel_Click"/><Button Content="使用全局默认设置" Click="ResetTranscriptionOptions_Click"/></StackPanel>
         </StackPanel>
        </Expander>
        <TextBlock Text="参数随当前媒体保存；修改用于下一次转写，正在运行的任务保持原参数。自动检测适合中英混合内容。" Style="{StaticResource Muted}" FontSize="12"/>
       </StackPanel></ScrollViewer>
      </StackPanel>
</Grid></Flyout></primitives:FlyoutBase.AttachedFlyout></ToggleButton>
        <DropDownButton Content="导出"><DropDownButton.Flyout><MenuFlyout>
         <MenuFlyoutSubItem Text="双语 · 原文 + 译文"><MenuFlyoutItem Text="SRT" Tag="Bilingual:srt" Click="Export_Click"/><MenuFlyoutItem Text="VTT" Tag="Bilingual:vtt" Click="Export_Click"/><MenuFlyoutItem Text="TXT" Tag="Bilingual:txt" Click="Export_Click"/><MenuFlyoutItem Text="ASS" Tag="Bilingual:ass" Click="Export_Click"/></MenuFlyoutSubItem><MenuFlyoutSubItem Text="仅原文"><MenuFlyoutItem Text="SRT" Tag="Original:srt" Click="Export_Click"/><MenuFlyoutItem Text="VTT" Tag="Original:vtt" Click="Export_Click"/><MenuFlyoutItem Text="TXT" Tag="Original:txt" Click="Export_Click"/><MenuFlyoutItem Text="ASS" Tag="Original:ass" Click="Export_Click"/></MenuFlyoutSubItem><MenuFlyoutSubItem Text="仅译文"><MenuFlyoutItem Text="SRT" Tag="Translation:srt" Click="Export_Click"/><MenuFlyoutItem Text="VTT" Tag="Translation:vtt" Click="Export_Click"/><MenuFlyoutItem Text="TXT" Tag="Translation:txt" Click="Export_Click"/><MenuFlyoutItem Text="ASS" Tag="Translation:ass" Click="Export_Click"/></MenuFlyoutSubItem><MenuFlyoutItem Text="笔记 Markdown" Tag="md" Click="Export_Click"/><MenuFlyoutItem Text="项目备份 JSON" Tag="json" Click="Export_Click"/><MenuFlyoutItem Text="思维导图 SVG" Tag="svg" Click="Export_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="压制双语字幕视频" Click="VideoExport_Click"/><MenuFlyoutItem Text="配音与字幕视频" Tag="dub" Click="VideoExport_Click"/><MenuFlyoutItem Text="导出选中片段" Click="ClipExport_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="输出到 Obsidian" Tag="obsidian" Click="Integration_Click"/><MenuFlyoutItem Text="发送到 Notion…" Tag="notion" Click="Integration_Click"/>
        </MenuFlyout></DropDownButton.Flyout></DropDownButton>
        <ToggleButton x:Name="AiToggle" Content="AI" IsChecked="True" Click="AiToggle_Click"/>
        <Button x:Name="MoreMediaButton" Width="34" Height="34" MinWidth="34" Padding="8" ToolTipService.ToolTip="更多操作" AutomationProperties.Name="更多操作"><FontIcon Glyph="&#xE712;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="重命名 / 移动文件夹" Click="Rename_Click"/><MenuFlyoutItem Text="关联音视频" Click="Associate_Click"/><MenuFlyoutItem Text="多行字幕拆为原文与译文" Click="SeparateBilingual_Click"/><MenuFlyoutItem Text="字幕版本与提案…" Click="TranscriptHistory_Click"/><MenuFlyoutItem Text="清理英语语气词…" Click="RemoveFillers_Click"/><MenuFlyoutItem Text="优化英语断句…" Click="SegmentSentences_Click"/><MenuFlyoutItem Text="修复重复字幕" Click="Repair_Click"/><MenuFlyoutItem Text="区分说话人" Click="Diarize_Click"/><MenuFlyoutItem Text="生成对齐配音" Click="Dub_Click"/><MenuFlyoutItem Text="显示 / 隐藏时间轴" Click="Timeline_Click"/><MenuFlyoutItem Text="悬浮字幕" Click="Floating_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="从媒体库移除" Click="Delete_Click"/></MenuFlyout></Button.Flyout></Button>
       </StackPanel>
      </Grid>
      <ui:ContinuousSurface x:Name="TranscriptionProgressCard" Grid.Row="1" Style="{StaticResource Card}" Padding="10" Visibility="Collapsed">
       <Grid ColumnSpacing="12" RowSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TranscriptionStage" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="TranscriptionPercent" Grid.Column="1" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button x:Name="CancelTranscription" Content="取消转写" Click="CancelTranscription_Click"/><Button Content="任务详情" Click="TranscriptionDetails_Click"/></StackPanel>
        <ProgressBar x:Name="TranscriptionProgress" Grid.Row="1" Grid.ColumnSpan="3" Height="5"/>
        <TextBlock x:Name="TranscriptionRunDetails" Grid.Row="2" Grid.ColumnSpan="3" FontSize="12" Style="{StaticResource Muted}"/>
       </Grid>
      </ui:ContinuousSurface>
      <Grid Grid.Row="2" ColumnSpacing="18" x:Name="WorkspaceColumns" SizeChanged="Workspace_SizeChanged">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AiColumn" Width="360"/></Grid.ColumnDefinitions>
       <Grid x:Name="MediaWorkspace" RowSpacing="12" ColumnSpacing="16" SizeChanged="MediaWorkspace_SizeChanged"><Grid.ColumnDefinitions><ColumnDefinition x:Name="VideoColumn" Width="*"/><ColumnDefinition x:Name="TranscriptColumn" Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="MediaTopRow" Height="Auto"/><RowDefinition x:Name="MediaMiddleRow" Height="*"/><RowDefinition x:Name="MediaBottomRow" Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="VideoPane" RowSpacing="4" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ui:ContinuousSurface x:Name="VideoSurface" Height="220" Background="#10141D" CornerRadius="0"><MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False"/></ui:ContinuousSurface>
         <Grid x:Name="PlaybackControls" Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="PlaybackButton" Click="PlaybackButton_Click" ToolTipService.ToolTip="播放 / 暂停" AutomationProperties.Name="播放或暂停"><FontIcon x:Name="PlaybackGlyph" Glyph="&#xE768;" FontSize="16"/></Button>
          <TextBlock x:Name="PlaybackPosition" Grid.Column="1" Text="00:00" FontSize="12" VerticalAlignment="Center"/>
          <Slider x:Name="PlaybackSeek" Grid.Column="2" Minimum="0" Maximum="1" ValueChanged="PlaybackSeek_Changed" AutomationProperties.Name="播放进度" VerticalAlignment="Center"/>
          <TextBlock x:Name="PlaybackDuration" Grid.Column="3" Text="00:00" FontSize="12" VerticalAlignment="Center"/>
          <Button Grid.Column="4" ToolTipService.ToolTip="音量与播放速度"><FontIcon Glyph="&#xE767;" FontSize="16"/><Button.Flyout><Flyout><StackPanel Spacing="12" Width="180"><TextBlock Text="音量"/><Slider Minimum="0" Maximum="100" Value="100" ValueChanged="PlaybackVolume_Changed" AutomationProperties.Name="音量"/><ComboBox Header="播放速度" SelectedIndex="1" SelectionChanged="PlaybackRate_Changed"><ComboBoxItem Content="0.75×" Tag="0.75"/><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="1.25×" Tag="1.25"/><ComboBoxItem Content="1.5×" Tag="1.5"/><ComboBoxItem Content="2×" Tag="2"/></ComboBox></StackPanel></Flyout></Button.Flyout></Button>
         </Grid>
         <ui:ContinuousSurface x:Name="TimelineBorder" Grid.Row="2" Height="52" Visibility="Collapsed" Style="{StaticResource Card}"><Canvas x:Name="TimelineCanvas" Background="Transparent" SizeChanged="Timeline_SizeChanged" PointerPressed="Timeline_Pressed"/></ui:ContinuousSurface>
        </Grid>
        <Grid x:Name="TranscriptPane" Grid.Row="1" Grid.ColumnSpan="2" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TranscriptSearchBar" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SubtitleSearch" PlaceholderText="搜索字幕 · Ctrl+F" TextChanged="SubtitleSearch_Changed"/><Button Grid.Column="1" Content="替换" Click="Replace_Click"/></Grid>
        <ListView x:Name="SubtitleList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="Subtitle_Changed" Background="Transparent" KeyDown="Subtitle_KeyDown">

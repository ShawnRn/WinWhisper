<Window x:Class="MemoAI.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="using:MemoAI.Core" xmlns:ui="using:MemoAI.App" Title="MemoAI Native">
 <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Margin="18,0,150,0" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="27" Height="27" CornerRadius="8" Background="#5365DA"><FontIcon Glyph="&#xE8F2;" FontSize="15" Foreground="White"/></Border>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="MemoAI" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Native" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
   <TextBlock x:Name="ArchitectureLabel" Grid.Column="3" Text="本地优先" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Grid>
  <NavigationView x:Name="Sidebar" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="222" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged" IsTabStop="False">
   <NavigationView.PaneHeader>
    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="12,12,12,14" Click="Import_Click" Padding="14,11"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" FontSize="15"/><TextBlock Text="导入音视频"/></StackPanel></Button>
   </NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="NavLibrary" Content="媒体库" Tag="library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="NavQueue" Content="任务与历史" Tag="queue"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="NavRecord" Content="录音" Tag="record"><NavigationViewItem.Icon><FontIcon Glyph="&#xE720;"/></NavigationViewItem.Icon><NavigationViewItem.InfoBadge><InfoBadge x:Name="RecordingBadge" Visibility="Collapsed"/></NavigationViewItem.InfoBadge></NavigationViewItem>
    <NavigationViewItem x:Name="NavLink" Content="导入在线链接" Tag="link"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemHeader Content="最近打开" Margin="0,14,0,0"/>
     <ListView x:Name="RecentList" MaxHeight="350" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Library_ItemClick" Background="Transparent" BorderThickness="0">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="70"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate x:DataType="core:MediaSession"><Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Title}"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="32" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top"><FontIcon Glyph="&#xE8B2;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind Title}" FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind DurationLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem x:Name="NavModels" Content="模型商店" Tag="models"><NavigationViewItem.Icon><FontIcon Glyph="&#xE719;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="NavSettings" Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <Border Margin="0,0,10,10" CornerRadius="14" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid>
     <Grid x:Name="LibraryView" Padding="30" RowSpacing="22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><StackPanel Spacing="7"><TextBlock Text="媒体库" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="从声音到文字，再到值得留下的想法。" Style="{StaticResource Muted}"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="PasteLink_Click" Content="粘贴链接"/></Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="62" Height="62" CornerRadius="18" Background="{ThemeResource AccentFillColorTertiaryBrush}"><FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7"><TextBlock Text="把内容带进来" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="拖入音视频、SRT 或 VTT 字幕，开始本地转写与整理。" Style="{StaticResource Muted}"/></StackPanel>
       <Button Grid.Column="2" Content="选择文件" VerticalAlignment="Center" Click="Import_Click" Padding="18,9"/>
      </Grid></Border>
      <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LibrarySearch" PlaceholderText="搜索标题、字幕与笔记" TextChanged="LibrarySearch_Changed"/><ComboBox x:Name="FolderFilter" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="全部文件夹" SelectionChanged="FolderFilter_Changed"/><Button Grid.Column="2" Content="批量转写" Click="Batch_Click"/></Grid>
      <Grid Grid.Row="3">
       <ListView x:Name="LibraryList" SelectionMode="Extended" IsItemClickEnabled="True" ItemClick="Library_ItemClick" Background="Transparent">
        <ListView.ItemTemplate><DataTemplate x:DataType="core:MediaSession"><Grid Padding="12,15" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="46" Height="46" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><FontIcon Glyph="&#xE8B2;" FontSize="21" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Border>
         <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{x:Bind DurationLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <StackPanel x:Name="LibraryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"><FontIcon Glyph="&#xE8F1;" FontSize="38" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><TextBlock Text="这里将收纳你的每一次灵感" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="导入第一段音视频，或从现有字幕开始。" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
     </Grid>
     <Grid x:Name="WorkspaceView" Visibility="Collapsed" RowSpacing="12" Padding="22,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="5"><TextBlock x:Name="SessionTitle" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SessionMeta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="StartTranscribeButton" Content="开始转写" Style="{StaticResource AccentButtonStyle}" Click="Transcribe_Click"/>
        <Button x:Name="TranscriptionSettingsButton" Content="转写设置"><Button.Flyout><Flyout x:Name="TranscriptionFlyout" Placement="BottomEdgeAlignedRight"><Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="MaxWidth" Value="680"/></Style></Flyout.FlyoutPresenterStyle><Grid x:Name="TranscriptionSettingsPanel" Width="600">      <StackPanel Spacing="16"><TextBlock Text="转写设置" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="TranscriptionSettingsSummary" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <ScrollViewer MaxHeight="450"><StackPanel Spacing="14">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="TranscriptionModel" Header="转写模型" HorizontalAlignment="Stretch" SelectionChanged="TranscriptionOption_Changed" DisplayMemberPath="Name"/>
         <ComboBox x:Name="TranscriptionLanguage" Grid.Column="1" Header="音频语言" HorizontalAlignment="Stretch" SelectionChanged="TranscriptionOption_Changed" DisplayMemberPath="Name"/>
         <ComboBox x:Name="TranscriptionBackend" Grid.Column="2" Header="硬件加速" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="TranscriptionOption_Changed"><ComboBoxItem Content="自动选择"/><ComboBoxItem Content="CUDA"/><ComboBoxItem Content="Vulkan"/><ComboBoxItem Content="CPU"/></ComboBox>
         <Button Grid.Column="3" Content="模型商店" VerticalAlignment="Bottom" Click="ModelStore_Click"/>
        </Grid>
        <Expander Header="高级参数" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <StackPanel Spacing="14">
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <NumberBox x:Name="TranscriptionThreads" Header="CPU 线程（0 自动）" Minimum="0" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
           <NumberBox x:Name="TranscriptionBeam" Grid.Column="1" Header="搜索宽度（1–10）" Minimum="1" Maximum="10" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
           <NumberBox x:Name="TranscriptionTemperature" Grid.Column="2" Header="采样温度（0–1）" Minimum="0" Maximum="1" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
          </Grid>
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <NumberBox x:Name="TranscriptionChunk" Header="处理分块（秒，30–900）" Minimum="30" Maximum="900" SmallChange="30" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
           <NumberBox x:Name="TranscriptionMaxLength" Grid.Column="1" Header="字幕长度（字符，0 不限）" Minimum="0" Maximum="200" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="TranscriptionNumber_Changed"/>
           <CheckBox x:Name="TranscriptionVad" Grid.Column="2" Content="检测静音（VAD）" VerticalAlignment="Bottom" Checked="TranscriptionCheck_Changed" Unchecked="TranscriptionCheck_Changed"/>
          </Grid>
          <TextBox x:Name="TranscriptionPrompt" Header="专有名词与上下文提示" PlaceholderText="例如：人名、产品名、技术术语…" TextChanged="TranscriptionPrompt_Changed"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="选择本地模型" Click="ChooseTranscriptionModel_Click"/><Button Content="使用全局默认设置" Click="ResetTranscriptionOptions_Click"/></StackPanel>
         </StackPanel>
        </Expander>
        <TextBlock Text="参数随当前媒体保存；修改用于下一次转写，正在运行的任务保持原参数。自动检测适合中英混合内容。" Style="{StaticResource Muted}" FontSize="12"/>
       </StackPanel></ScrollViewer>
      </StackPanel>
</Grid></Flyout></Button.Flyout></Button>
        <DropDownButton Content="导出"><DropDownButton.Flyout><MenuFlyout>
         <MenuFlyoutItem Text="双语字幕 SRT" Tag="srt" Click="Export_Click"/><MenuFlyoutItem Text="字幕 VTT" Tag="vtt" Click="Export_Click"/><MenuFlyoutItem Text="字幕 ASS" Tag="ass" Click="Export_Click"/><MenuFlyoutItem Text="纯文本 TXT" Tag="txt" Click="Export_Click"/><MenuFlyoutItem Text="笔记 Markdown" Tag="md" Click="Export_Click"/><MenuFlyoutItem Text="项目备份 JSON" Tag="json" Click="Export_Click"/><MenuFlyoutItem Text="思维导图 SVG" Tag="svg" Click="Export_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="压制双语字幕视频" Click="VideoExport_Click"/><MenuFlyoutItem Text="配音与字幕视频" Tag="dub" Click="VideoExport_Click"/><MenuFlyoutItem Text="导出选中片段" Click="ClipExport_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="输出到 Obsidian" Tag="obsidian" Click="Integration_Click"/><MenuFlyoutItem Text="发送到 Notion…" Tag="notion" Click="Integration_Click"/>
        </MenuFlyout></DropDownButton.Flyout></DropDownButton>
        <ToggleButton x:Name="AiToggle" Content="AI" IsChecked="True" Click="AiToggle_Click"/>
        <Button Content="···"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="重命名 / 移动文件夹" Click="Rename_Click"/><MenuFlyoutItem Text="关联音视频" Click="Associate_Click"/><MenuFlyoutItem Text="多行字幕拆为原文与译文" Click="SeparateBilingual_Click"/><MenuFlyoutItem Text="修复重复字幕" Click="Repair_Click"/><MenuFlyoutItem Text="区分说话人" Click="Diarize_Click"/><MenuFlyoutItem Text="生成对齐配音" Click="Dub_Click"/><MenuFlyoutItem Text="显示 / 隐藏时间轴" Click="Timeline_Click"/><MenuFlyoutItem Text="悬浮字幕" Click="Floating_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="从媒体库移除" Click="Delete_Click"/></MenuFlyout></Button.Flyout></Button>
       </StackPanel>
      </Grid>
      <Border x:Name="TranscriptionProgressCard" Grid.Row="1" Style="{StaticResource Card}" Padding="10" Visibility="Collapsed">
       <Grid ColumnSpacing="12" RowSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TranscriptionStage" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="TranscriptionPercent" Grid.Column="1" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button x:Name="CancelTranscription" Content="取消转写" Click="CancelTranscription_Click"/><Button Content="任务详情" Click="TranscriptionDetails_Click"/></StackPanel>
        <ProgressBar x:Name="TranscriptionProgress" Grid.Row="1" Grid.ColumnSpan="3" Height="5"/>
        <TextBlock x:Name="TranscriptionRunDetails" Grid.Row="2" Grid.ColumnSpan="3" FontSize="12" Style="{StaticResource Muted}"/>
       </Grid>
      </Border>
      <Grid Grid.Row="2" ColumnSpacing="18" x:Name="WorkspaceColumns" SizeChanged="Workspace_SizeChanged">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AiColumn" Width="360"/></Grid.ColumnDefinitions>
       <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="280" MaxHeight="400"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
         <Border Background="#10141D" CornerRadius="10"><MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False"/></Border>
         <Grid x:Name="PlaybackControls" Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="PlaybackButton" Click="PlaybackButton_Click" ToolTipService.ToolTip="播放 / 暂停" AutomationProperties.Name="播放或暂停"><FontIcon x:Name="PlaybackGlyph" Glyph="&#xE768;" FontSize="16"/></Button>
          <TextBlock x:Name="PlaybackPosition" Grid.Column="1" Text="00:00" FontSize="12" VerticalAlignment="Center"/>
          <Slider x:Name="PlaybackSeek" Grid.Column="2" Minimum="0" Maximum="1" ValueChanged="PlaybackSeek_Changed" AutomationProperties.Name="播放进度" VerticalAlignment="Center"/>
          <TextBlock x:Name="PlaybackDuration" Grid.Column="3" Text="00:00" FontSize="12" VerticalAlignment="Center"/>
          <Button Grid.Column="4" ToolTipService.ToolTip="音量与播放速度"><FontIcon Glyph="&#xE767;" FontSize="16"/><Button.Flyout><Flyout><StackPanel Spacing="12" Width="180"><TextBlock Text="音量"/><Slider Minimum="0" Maximum="100" Value="100" ValueChanged="PlaybackVolume_Changed" AutomationProperties.Name="音量"/><ComboBox Header="播放速度" SelectedIndex="1" SelectionChanged="PlaybackRate_Changed"><ComboBoxItem Content="0.75×" Tag="0.75"/><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="1.25×" Tag="1.25"/><ComboBoxItem Content="1.5×" Tag="1.5"/><ComboBoxItem Content="2×" Tag="2"/></ComboBox></StackPanel></Flyout></Button.Flyout></Button>
         </Grid>
        </Grid>
        <Border x:Name="TimelineBorder" Grid.Row="1" Height="52" Visibility="Collapsed" Style="{StaticResource Card}"><Canvas x:Name="TimelineCanvas" Background="Transparent" SizeChanged="Timeline_SizeChanged" PointerPressed="Timeline_Pressed"/></Border>
        <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SubtitleSearch" PlaceholderText="搜索字幕 · Ctrl+F" TextChanged="SubtitleSearch_Changed"/><Button Grid.Column="1" Content="替换" Click="Replace_Click"/></Grid>
        <ListView x:Name="SubtitleList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="Subtitle_Changed" Background="Transparent" KeyDown="Subtitle_KeyDown">
         <ListView.ItemTemplate><DataTemplate x:DataType="core:SubtitleSegment"><StackPanel Padding="8,8" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{x:Bind TimeLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{x:Bind Speaker, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="16" LineHeight="27" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Translation, Mode=OneWay}" FontSize="15" LineHeight="25" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10"><StackPanel Spacing="8"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="EditorTime" Text="选择字幕进行编辑" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Content="时间" Click="EditTiming_Click" FontSize="12" Padding="8,3"/><Button Content="拆分" Click="Split_Click" FontSize="12" Padding="8,3"/><Button Content="合并" Click="Merge_Click" FontSize="12" Padding="8,3"/><Button Content="撤销" Click="Undo_Click" FontSize="12" Padding="8,3"/></StackPanel></Grid><TextBox x:Name="OriginalEditor" PlaceholderText="原文" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="76" TextChanged="Editor_Changed" GotFocus="Editor_Focus"/><TextBox x:Name="TranslationEditor" PlaceholderText="译文" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="66" TextChanged="Editor_Changed" GotFocus="Editor_Focus"/></StackPanel></Border>
       </Grid>
       <Border x:Name="AiPanel" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
        <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid><StackPanel Spacing="4"><TextBlock Text="与内容对话" FontSize="17" FontWeight="SemiBold"/><HyperlinkButton Click="ModelStore_Click" Padding="0" HorizontalAlignment="Left"><TextBlock x:Name="AiProviderLabel" Text="选择本地模型" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="260"/></HyperlinkButton></StackPanel><Button x:Name="BackToChat" Content="返回对话" Visibility="Collapsed" HorizontalAlignment="Right" Click="BackToChat_Click"/></Grid>
         <Grid x:Name="AiActions" Grid.Row="1" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="内容总结" Tag="summary" Click="Ai_Click" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="翻译字幕" Tag="translate" Click="Ai_Click" HorizontalAlignment="Stretch"/><DropDownButton x:Name="MoreAiTools" Grid.Column="2" Content="更多"><DropDownButton.Flyout><MenuFlyout><MenuFlyoutItem Text="生成章节" Tag="chapters" Click="Ai_Click"/><MenuFlyoutItem Text="思维导图" Tag="mindmap" Click="Ai_Click"/><MenuFlyoutItem Text="校对字幕" Tag="correct" Click="Ai_Click"/></MenuFlyout></DropDownButton.Flyout></DropDownButton></Grid>
         <Grid Grid.Row="2"><ListView x:Name="ChatMessages" SelectionMode="None" Background="Transparent" BorderThickness="0" Loaded="ChatMessages_Loaded"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="core:ChatTurn"><StackPanel Spacing="7" Margin="0,12"><TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Padding="10" CornerRadius="10" Loaded="ChatBubble_Loaded"><ui:NativeMarkdownView Text="{x:Bind Content, Mode=OneWay}"/></Border><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="复制" FontSize="12" Padding="6,2" Tag="{x:Bind}" Click="CopyChat_Click"/><TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TreeView x:Name="MindMapTree" Visibility="Collapsed"/></Grid>
         <StackPanel Grid.Row="3" Spacing="5"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ProgressRing x:Name="AiActivityRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/><TextBlock x:Name="AiActivityText" Grid.Column="1" Text="选择一项操作，或向这段内容提问。" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Grid><TextBlock x:Name="AiActivityDetails" FontSize="12" Style="{StaticResource Muted}"/><ProgressBar x:Name="AiActivityProgress" Height="3" Visibility="Collapsed"/></StackPanel>
         <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8"><StackPanel Spacing="7"><TextBox x:Name="QuestionBox" PlaceholderText="问问这段内容…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MinHeight="60" BorderThickness="0" Background="Transparent" TextChanged="Question_Changed" KeyDown="Question_KeyDown"/><Grid><TextBlock Text="Ctrl+Enter 发送" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"><Button x:Name="StopAiButton" Content="停止" Click="StopAi_Click" IsEnabled="False" Visibility="Collapsed"/><Button x:Name="AskAiButton" Content="发送" Tag="ask" Click="Ai_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Grid></StackPanel></Border>
        </Grid>
       </Border>
      </Grid>
     </Grid>
     <Grid x:Name="QueueView" Visibility="Collapsed" Padding="30" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="6"><TextBlock Text="任务与历史" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="后台处理，随时取消；已完成的转写片段会保存为恢复检查点。" Style="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="取消选中任务" Click="CancelJob_Click"/><Button Content="重试 / 恢复" Click="RetryJob_Click"/></StackPanel><ListView Grid.Row="2" x:Name="JobList" SelectionChanged="Job_Changed"/><TextBox Grid.Row="3" x:Name="JobDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" AcceptsReturn="True"/></Grid>
     <ScrollViewer x:Name="RecordView" Visibility="Collapsed"><StackPanel Padding="30" Spacing="22" MaxWidth="940" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8"><TextBlock Text="录音" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="记录系统声音、麦克风，或两者一起。录音只保存在这台设备。" Style="{StaticResource Muted}"/></StackPanel>
      <Border Style="{StaticResource Card}" Padding="28"><StackPanel Spacing="20">
       <TextBlock Text="音频来源" FontSize="16" FontWeight="SemiBold"/>
       <ComboBox x:Name="RecordingMode" SelectedIndex="0" HorizontalAlignment="Stretch" MaxWidth="460" HorizontalContentAlignment="Left" AutomationProperties.Name="录音音频来源"><ComboBoxItem Content="系统音频"/><ComboBoxItem Content="麦克风"/><ComboBoxItem Content="系统音频 + 麦克风"/></ComboBox>
       <TextBlock x:Name="RecordingTime" Text="00:00:00" FontSize="48" FontFamily="Segoe UI Variable Display"/>
       <TextBlock x:Name="RecordingState" Text="准备好后，点击开始录音。" Style="{StaticResource Muted}"/>
       <Button x:Name="RecordingAction" Content="开始录音" Style="{StaticResource AccentButtonStyle}" Click="Record_Click" Padding="20,10"/>
      </StackPanel></Border>
      <TextBlock Text="录音时可以切换到其他功能区。结束后点击「停止并保存」，音频会自动加入媒体库。" Style="{StaticResource Muted}"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="LinkView" Visibility="Collapsed"><StackPanel Padding="30" Spacing="22" MaxWidth="940" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8"><TextBlock Text="导入在线链接" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="粘贴视频、播客或媒体链接，下载后在本地转写与整理。" Style="{StaticResource Muted}"/></StackPanel>
      <Border Style="{StaticResource Card}" Padding="28"><StackPanel Spacing="18">
       <TextBlock Text="媒体链接" FontSize="16" FontWeight="SemiBold"/>
       <TextBox x:Name="LinkInput" PlaceholderText="https://…" AutomationProperties.Name="在线媒体链接"/>
       <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="LinkQuality" Header="下载内容" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="视频 · 最高 1080p"/><ComboBoxItem Content="视频 · 最高 720p"/><ComboBoxItem Content="视频 · 最佳画质"/><ComboBoxItem Content="仅音频（播客 / 转写）"/></ComboBox>
        <ComboBox x:Name="LinkCookieBrowser" Grid.Column="1" Header="浏览器 Cookie" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="不读取浏览器 Cookie" Tag=""/><ComboBoxItem Content="Microsoft Edge" Tag="edge"/><ComboBoxItem Content="Google Chrome" Tag="chrome"/><ComboBoxItem Content="Firefox" Tag="firefox"/><ComboBoxItem Content="Brave" Tag="brave"/><ComboBoxItem Content="Vivaldi" Tag="vivaldi"/><ComboBoxItem Content="Opera" Tag="opera"/><ComboBoxItem Content="Chromium" Tag="chromium"/></ComboBox>
       </Grid>
       <TextBox x:Name="LinkBrowserProfile" Header="浏览器个人资料（可选）" PlaceholderText="留空使用最近使用的资料；也可填 Default、Profile 1 或资料路径"/>
       <TextBlock Text="仅下载时读取你选定浏览器的登录状态，交给 yt-dlp 使用，不保存或展示 Cookie。若浏览器锁定或加密导致无法读取，会明确提示。" Style="{StaticResource Muted}" FontSize="12"/>
       <CheckBox x:Name="LinkAutoTranscribe" Content="下载完成后自动开始本地转写" IsChecked="True"/>
       <Expander Header="网络与登录选项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBox x:Name="LinkProxy" Header="代理地址（可选）" PlaceholderText="留空使用系统代理，例如 http://127.0.0.1:7897"/><TextBox x:Name="LinkCookieFile" Header="Cookie 文件（可选，优先于浏览器读取）" IsReadOnly="True" PlaceholderText="Netscape 格式的 .txt 文件"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="选择 Cookie 文件" Click="ChooseCookieFile_Click"/><Button Content="清除选择" Click="ClearCookieFile_Click"/></StackPanel></StackPanel></Expander>
       <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="LinkDownload" Content="下载并导入" Click="DownloadLink_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="粘贴链接" Click="PasteLink_Click"/><Button x:Name="LinkCancel" Content="取消下载" Click="CancelLink_Click" Visibility="Collapsed"/></StackPanel>
       <ProgressBar x:Name="LinkProgress" IsIndeterminate="True" Visibility="Collapsed"/>
       <TextBlock x:Name="LinkDownloadStatus" Text="支持 yt-dlp 可下载的站点，使用系统网络代理。" Style="{StaticResource Muted}" IsTextSelectionEnabled="True"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"><StackPanel x:Name="SettingsContent" Padding="30" Spacing="18" MaxWidth="1000" HorizontalAlignment="Stretch"/></ScrollViewer>
     <Grid x:Name="ModelStoreView" Visibility="Collapsed" Padding="30" RowSpacing="20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="模型商店" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="为你的内容，选一位本地搭档。下载、应用，都在这里完成。" Style="{StaticResource Muted}"/></StackPanel><Button Grid.Column="1" Content="导入本地模型" VerticalAlignment="Center" Click="ImportModel_Click"/></Grid>
      <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StoreSearch" PlaceholderText="搜索模型、语言或用途" TextChanged="StoreFilter_Changed"/><ComboBox Grid.Column="1" x:Name="StoreCategory" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="StoreCategory_Changed"><ComboBoxItem Content="全部模型"/><ComboBoxItem Content="音视频转写"/><ComboBoxItem Content="翻译与总结"/><ComboBoxItem Content="配音与说话人"/><ComboBoxItem Content="已下载"/></ComboBox><Button Grid.Column="2" Content="刷新 Ollama" Click="RefreshOllama_Click"/></Grid>
      <ScrollViewer x:Name="StoreScroll" Grid.Row="2"><StackPanel x:Name="StoreCards" Spacing="14" Padding="0,0,8,12"/></ScrollViewer>
     </Grid>
     <InfoBar x:Name="OperationNotice" IsOpen="False" IsClosable="True" IsIconVisible="True" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="540" Margin="18" Canvas.ZIndex="10">
      <ProgressBar x:Name="OperationProgress" Height="3" MinWidth="180" Visibility="Collapsed"/>
     </InfoBar>
    </Grid>
   </Border>
  </NavigationView>
 </Grid>
</Window>

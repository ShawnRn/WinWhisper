       </Grid>
       <ui:ContinuousSurface x:Name="AiPanel" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
        <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="与内容对话" FontSize="17" FontWeight="SemiBold"/><HyperlinkButton Click="ModelStore_Click" Padding="0" HorizontalAlignment="Left"><TextBlock x:Name="AiProviderLabel" Text="选择本地模型" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="260"/></HyperlinkButton></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button x:Name="TranscriptHistoryButton" Width="32" Height="32" Padding="7" AutomationProperties.Name="字幕版本与提案" ToolTipService.ToolTip="版本、Diff、允许 / 拒绝与回滚" Click="TranscriptHistory_Click"><FontIcon Glyph="&#xE81C;" FontSize="14"/></Button><Button x:Name="BackToChat" Content="对话" Visibility="Collapsed" Click="BackToChat_Click"/></StackPanel></Grid>
         <Grid x:Name="AiActions" Grid.Row="1" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="内容总结" Tag="summary" Click="Ai_Click" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="翻译字幕" Tag="translate" Click="Ai_Click" HorizontalAlignment="Stretch"/><DropDownButton x:Name="MoreAiTools" Grid.Column="2" Content="更多"><DropDownButton.Flyout><MenuFlyout><MenuFlyoutItem Text="生成章节" Tag="chapters" Click="Ai_Click"/><MenuFlyoutItem Text="思维导图" Tag="mindmap" Click="Ai_Click"/><MenuFlyoutItem Text="校对 / 修改字幕…" Tag="correct" Click="Ai_Click"/><MenuFlyoutItem Text="优化英语断句…" Click="SegmentSentences_Click"/><MenuFlyoutItem Text="清理英语语气词…" Click="RemoveFillers_Click"/></MenuFlyout></DropDownButton.Flyout></DropDownButton></Grid>
         <Grid Grid.Row="2"><ListView x:Name="ChatMessages" SelectionMode="None" Background="Transparent" BorderThickness="0" Loaded="ChatMessages_Loaded"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="core:ChatTurn"><Grid RowSpacing="4" Margin="0,8" PointerEntered="ChatChrome_Entered" PointerExited="ChatChrome_Exited" GotFocus="ChatChrome_Focus" LostFocus="ChatChrome_Focus">
<Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" FontSize="11" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><Button x:Name="CopyTurnButton" Grid.Column="2" Width="28" Height="28" MinWidth="28" Padding="6" Opacity="0" IsHitTestVisible="False" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="复制消息" ToolTipService.ToolTip="复制消息" Tag="{x:Bind}" Click="CopyChat_Click"><FontIcon Glyph="&#xE8C8;" FontSize="13"/></Button></Grid>
<ui:ContinuousSurface Grid.Row="1" Padding="10" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Loaded="ChatBubble_Loaded"><ui:NativeMarkdownView Text="{x:Bind Content, Mode=OneWay}" TimestampClicked="ChatTimestamp_Click"/></ui:ContinuousSurface></Grid></DataTemplate></ListView.ItemTemplate></ListView><TreeView x:Name="MindMapTree" Visibility="Collapsed"/></Grid>
         <StackPanel Grid.Row="3" Spacing="5"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ProgressRing x:Name="AiActivityRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/><TextBlock x:Name="AiActivityText" Grid.Column="1" Text="选择一项操作，或向这段内容提问。" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Grid><TextBlock x:Name="AiActivityDetails" FontSize="12" Style="{StaticResource Muted}"/><ProgressBar x:Name="AiActivityProgress" Height="3" Visibility="Collapsed"/></StackPanel>
         <ui:ContinuousSurface Grid.Row="4" Style="{StaticResource Card}" Padding="8"><StackPanel Spacing="7"><Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TranscriptAccessLabel" Text="已连接完整转写" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><ToggleButton x:Name="ChatEditMode" Grid.Column="1" Content="修改字幕" FontSize="12" Padding="8,4" Checked="ChatEditMode_Changed" Unchecked="ChatEditMode_Changed" ToolTipService.ToolTip="开启后，将修改要求生成可预览、可撤销的字幕编辑；关闭时只回答问题。"/></Grid><TextBox x:Name="QuestionBox" PlaceholderText="问问这段内容…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MinHeight="60" BorderThickness="0" Background="Transparent" TextChanged="Question_Changed" PreviewKeyDown="Question_KeyDown"/><Grid><TextBlock Text="Enter 发送 · Shift+Enter 换行" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"><Button x:Name="StopAiButton" Content="停止" Click="StopAi_Click" IsEnabled="False" Visibility="Collapsed"/><Button x:Name="AskAiButton" Content="发送" Tag="ask" Click="Ai_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Grid></StackPanel></ui:ContinuousSurface>
        </Grid>
       </ui:ContinuousSurface>
      </Grid>
     </Grid>
     <Grid x:Name="QueueView" Visibility="Collapsed" Padding="30" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="6"><TextBlock Text="任务与历史" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="后台处理，随时取消；已完成的转写片段会保存为恢复检查点。" Style="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="取消选中任务" Click="CancelJob_Click"/><Button Content="重试 / 恢复" Click="RetryJob_Click"/></StackPanel><ListView Grid.Row="2" x:Name="JobList" SelectionChanged="Job_Changed"/><TextBox Grid.Row="3" x:Name="JobDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" AcceptsReturn="True"/></Grid>
     <ScrollViewer x:Name="RecordView" Visibility="Collapsed" HorizontalContentAlignment="Stretch" SizeChanged="RecordingView_SizeChanged"><StackPanel x:Name="RecordingContent" Margin="30" Spacing="22" MaxWidth="940" HorizontalAlignment="Center">
      <StackPanel Spacing="8"><TextBlock Text="录音" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="记录系统声音、麦克风，或两者一起。录音只保存在这台设备。" Style="{StaticResource Muted}"/></StackPanel>
      <ui:ContinuousSurface Style="{StaticResource Card}" Padding="28"><StackPanel Spacing="20">
       <TextBlock Text="音频来源" FontSize="16" FontWeight="SemiBold"/>
       <ComboBox x:Name="RecordingMode" SelectedIndex="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" SelectionChanged="RecordingMode_Changed" AutomationProperties.Name="录音音频来源"><ComboBoxItem Content="系统音频（内录）"/><ComboBoxItem Content="麦克风"/><ComboBoxItem Content="系统音频 + 麦克风"/><ComboBoxItem Content="单个 App（含子进程）"/></ComboBox>
       <Grid x:Name="RecordingAppPanel" Visibility="Collapsed" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="RecordingApp" Header="选择 App" DisplayMemberPath="Name" HorizontalAlignment="Stretch" PlaceholderText="先打开要录制的 App"/><Button Grid.Column="1" Content="刷新 App" VerticalAlignment="Bottom" Click="RefreshRecordingApps_Click"/></Grid>
       <ToggleSwitch x:Name="RecordingLive" Header="边录边转文字" OffContent="仅录音" OnContent="使用本地模型转写"/>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="RecordingModel" Header="端侧转写模型" HorizontalAlignment="Stretch" DisplayMemberPath="Name" PlaceholderText="从模型商店下载并应用"/><ComboBox x:Name="RecordingLanguage" Grid.Column="1" Header="语言" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/><Button Grid.Column="2" Content="模型商店" VerticalAlignment="Bottom" Click="ModelStore_Click"/></Grid>
       <TextBlock Text="每 6 秒处理一段，延迟还取决于模型速度；模型较慢时会显示待处理片段。Whisper 按片段加载，ONNX 模型保持载入。" Style="{StaticResource Muted}" FontSize="12"/>
       <TextBlock x:Name="RecordingTime" Text="00:00:00" FontSize="48" FontFamily="Segoe UI Variable Display"/>
       <TextBlock x:Name="RecordingState" Text="准备好后，点击开始录音。" Style="{StaticResource Muted}"/>
       <Button x:Name="RecordingAction" Content="开始录音" Style="{StaticResource AccentButtonStyle}" Click="Record_Click" Padding="20,10"/>
       <StackPanel x:Name="LiveRecordingPanel" Visibility="Collapsed" Spacing="10"><TextBlock x:Name="LiveRecordingStatus" TextWrapping="Wrap"/><ProgressBar x:Name="LiveRecordingProgress" IsIndeterminate="True" Height="3"/><TextBox x:Name="LiveRecordingText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="280" PlaceholderText="识别出的文字会显示在这里，并自动保存。"/><Button x:Name="CancelLiveRecording" Content="停止转写，继续录音" Click="CancelLiveRecording_Click" HorizontalAlignment="Left"/></StackPanel>
      </StackPanel></ui:ContinuousSurface>
      <TextBlock Text="录音时可以切换到其他功能区。结束后点击「停止并保存」，音频会自动加入媒体库。" Style="{StaticResource Muted}"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="LinkView" Visibility="Collapsed"><StackPanel Padding="30" Spacing="22" MaxWidth="940" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8"><TextBlock Text="导入在线链接" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="粘贴视频、播客或媒体链接，下载后在本地转写与整理。" Style="{StaticResource Muted}"/></StackPanel>
